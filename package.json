{
  "name": "cutcut-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm --workspace=@cutcut/frontend run dev",
    "dev:frontend": "npm --workspace=@cutcut/frontend run dev",
    "build:frontend": "npm --workspace=@cutcut/frontend run build",
    "build": "npm --workspace=@cutcut/frontend run build"
  }
}
