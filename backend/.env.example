# Copy this file to .env and paste your keys. .env is git-ignored.

# Required: fast free models for the Planner, Screener and Reviewer. https://console.groq.com/keys
GROQ_API_KEY=

# Recommended: the stronger Judge. Without it the Judge uses Groq's larger model. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: see every graph run in LangSmith. https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=viralbits-agents

# Models (defaults shown)
MODEL_FAST=openai/gpt-oss-20b
MODEL_STRONG=gemini-flash-latest
MODEL_STRONG_BACKUP=gemini-flash-lite-latest
MODEL_STRONG_FALLBACK=openai/gpt-oss-120b

# Most tokens one run may spend across all agents before cheaper shortcuts take over.
MAX_RUN_TOKENS=24000
